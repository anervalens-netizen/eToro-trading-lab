[Unit]
Description=eToro Trading Lab v2 read-only DEMO reconciliation
After=network-online.target postgresql.service
Wants=network-online.target
ConditionPathExists=/etc/etoro-agent/v2-demo.json
ConditionPathExists=/etc/etoro-agent/etoro-demo-read-user-key
ConditionPathExists=/etc/etoro-agent/etoro-api-key
ConditionPathExists=/etc/etoro-agent/postgres-v2-reconciler-dsn

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=180
User=etoro-reconciler
Group=etoro-reconciler
SupplementaryGroups=etoro-api-clients
UMask=0007
WorkingDirectory=/opt/etoro-v2/current
Environment=PYTHONUNBUFFERED=1
Environment=ETORO_V2_SHARED_RATE_LIMIT_DIR=/run/etoro-v2-api-rate-limit
Environment=ETORO_USER_KEY_FILE=/run/credentials/etoro-v2-reconciliation.service/etoro-demo-read-user-key
Environment=ETORO_API_KEY_FILE=/run/credentials/etoro-v2-reconciliation.service/etoro-api-key
Environment=ETORO_V2_POSTGRES_DSN_FILE=/run/credentials/etoro-v2-reconciliation.service/postgres-v2-dsn
LoadCredential=etoro-demo-read-user-key:/etc/etoro-agent/etoro-demo-read-user-key
LoadCredential=etoro-api-key:/etc/etoro-agent/etoro-api-key
LoadCredential=postgres-v2-dsn:/etc/etoro-agent/postgres-v2-reconciler-dsn
LoadCredential=v2-demo.json:/etc/etoro-agent/v2-demo.json
ExecStart=/opt/etoro-v2/current/.venv/bin/python -m etoro_agent.reconciliation_v2 --config /run/credentials/etoro-v2-reconciliation.service/v2-demo.json --interval 10
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectProc=invisible
ProcSubset=pid
CapabilityBoundingSet=
AmbientCapabilities=
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
