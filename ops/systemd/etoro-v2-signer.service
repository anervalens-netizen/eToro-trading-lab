[Unit]
Description=eToro Trading Lab v2 isolated deterministic DEMO risk signer
ConditionPathExists=/etc/etoro-agent/v2-demo.json
ConditionPathExists=/etc/etoro-agent/v2-risk-signing.key
Before=etoro-v2-decision-apply-execution.service

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=60
User=etoro-signer
Group=etoro-sign-requesters
WorkingDirectory=/opt/etoro-v2/current
UMask=0007
RuntimeDirectory=etoro-v2-signer
RuntimeDirectoryMode=0750
LoadCredential=v2-risk-signing.key:/etc/etoro-agent/v2-risk-signing.key
LoadCredential=v2-demo.json:/etc/etoro-agent/v2-demo.json
ExecStart=/opt/etoro-v2/current/.venv/bin/python -m etoro_agent.risk_signer_ipc_v2 --socket /run/etoro-v2-signer/risk-signer.sock --config /run/credentials/etoro-v2-signer.service/v2-demo.json --private-key /run/credentials/etoro-v2-signer.service/v2-risk-signing.key --allowed-peer-user etoro-decision-exec --allowed-peer-user etoro-exit
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateNetwork=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectProc=invisible
ProcSubset=pid
CapabilityBoundingSet=
AmbientCapabilities=
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
