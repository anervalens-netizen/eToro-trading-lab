[Unit]
Description=eToro Trading Lab v2 verified backup
ConditionPathIsDirectory=/storage/backups/db/etoro/v2
ConditionPathExists=/etc/etoro-agent/postgres-v2-backup.conf

[Service]
Type=oneshot
User=etoro-observer
Group=etoro-observer
WorkingDirectory=/opt/etoro-v2/current
Environment=ETORO_V2_BACKUP_ROOT=/storage/backups/db/etoro/v2
Environment=ETORO_V2_POSTGRES_SERVICE=etoro_v2_backup
Environment=PGSERVICEFILE=/run/credentials/etoro-v2-backup.service/postgres-v2-pgservice
LoadCredential=postgres-v2-pgservice:/etc/etoro-agent/postgres-v2-backup.conf
ExecStart=/opt/etoro-v2/current/ops/backup/backup-v2.sh
ExecStartPost=/usr/bin/find /storage/backups/db/etoro/v2 -maxdepth 1 -type f -exec /usr/bin/setfacl -m u:andrei:r-- {} +
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/storage/backups/db/etoro/v2
ProtectProc=invisible
ProcSubset=pid
CapabilityBoundingSet=
AmbientCapabilities=
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
PrivateNetwork=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
