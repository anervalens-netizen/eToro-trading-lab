[Unit]
Description=eToro Trading Lab v2 official WebSocket archive (DEMO research)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/etoro-agent/v2-demo.json
ConditionPathExists=/etc/etoro-agent/etoro-demo-read-user-key
ConditionPathExists=/etc/etoro-agent/etoro-api-key
ConditionPathExists=/etc/etoro-agent/postgres-v2-collector-dsn

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=180
User=etoro-collector
Group=etoro-collector
WorkingDirectory=/opt/etoro-v2/current
Environment=PYTHONUNBUFFERED=1
Environment=ETORO_V2_SHARED_RATE_LIMIT_DIR=/run/etoro-v2-api-rate-limit
Environment=ETORO_USER_KEY_FILE=/run/credentials/etoro-v2-market.service/etoro-demo-read-user-key
Environment=ETORO_API_KEY_FILE=/run/credentials/etoro-v2-market.service/etoro-api-key
LoadCredential=etoro-demo-read-user-key:/etc/etoro-agent/etoro-demo-read-user-key
LoadCredential=etoro-api-key:/etc/etoro-agent/etoro-api-key
LoadCredential=v2-demo.json:/etc/etoro-agent/v2-demo.json
LoadCredential=postgres-v2-dsn:/etc/etoro-agent/postgres-v2-collector-dsn
ExecStart=/opt/etoro-v2/current/.venv/bin/python -m etoro_agent.market_worker_v2 --config /run/credentials/etoro-v2-market.service/v2-demo.json --index /var/lib/etoro-collector/market-archive-v2.sqlite3 --postgres-dsn-file /run/credentials/etoro-v2-market.service/postgres-v2-dsn
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
StateDirectory=etoro-collector
StateDirectoryMode=0700
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectProc=invisible
ProcSubset=pid
CapabilityBoundingSet=
AmbientCapabilities=
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
