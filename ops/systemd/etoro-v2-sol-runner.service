[Unit]
Description=eToro Trading Lab v2 stateless ChatGPT-authenticated Sol multi-role runner
Requires=etoro-v2-sol-model.socket
After=network-online.target etoro-v2-sol-model.socket
Wants=network-online.target
ConditionPathExists=/home/andrei/.codex/auth.json
ConditionPathExists=/home/andrei/.ssh/known_hosts

[Service]
Type=simple
User=andrei
Group=andrei
WorkingDirectory=/opt/etoro-v2/current
Environment=PYTHONUNBUFFERED=1
Environment=ETORO_V2_AI_WORKER_ID=dell-sol-v2
EnvironmentFile=-/etc/etoro-agent/sol-v2-runner.env
ExecStart=/opt/etoro-v2/current/.venv/bin/python -m etoro_agent.sol_runner_v2 --interval 60 --daily-cap 30
Restart=on-failure
RestartSec=15
MemoryMax=512M
TasksMax=64
LimitFSIZE=16777216
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
BindReadOnlyPaths=/home/andrei/.ssh/known_hosts:/run/etoro-v2-sol-runner-known-hosts
InaccessiblePaths=-/etc/etoro-agent
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
