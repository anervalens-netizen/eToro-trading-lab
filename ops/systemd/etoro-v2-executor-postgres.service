[Unit]
Description=eToro Trading Lab v2 production PostgreSQL autonomous DEMO executor
After=network-online.target postgresql.service
Wants=network-online.target
ConditionPathExists=/etc/etoro-agent/v2-demo-execution.json
ConditionPathExists=/etc/etoro-agent/etoro-demo-write-user-key
ConditionPathExists=/etc/etoro-agent/etoro-api-key
ConditionPathExists=/etc/etoro-agent/postgres-v2-dsn
ConditionPathExists=/etc/etoro-agent/ENABLE_V2_DEMO_EXECUTION

[Service]
Type=simple
User=etoro-agent
Group=etoro-agent
WorkingDirectory=/opt/eToro
Environment=PYTHONUNBUFFERED=1
Environment=ETORO_USER_KEY_FILE=/run/credentials/etoro-v2-executor-postgres.service/etoro-demo-write-user-key
Environment=ETORO_API_KEY_FILE=/run/credentials/etoro-v2-executor-postgres.service/etoro-api-key
Environment=ETORO_V2_POSTGRES_DSN_FILE=/run/credentials/etoro-v2-executor-postgres.service/postgres-v2-dsn
LoadCredential=etoro-demo-write-user-key:/etc/etoro-agent/etoro-demo-write-user-key
LoadCredential=etoro-api-key:/etc/etoro-agent/etoro-api-key
LoadCredential=postgres-v2-dsn:/etc/etoro-agent/postgres-v2-dsn
LoadCredential=v2-demo-execution.json:/etc/etoro-agent/v2-demo-execution.json
ExecStart=/opt/eToro/.venv/bin/python -m etoro_agent.executor_service_postgres_v2 --config /run/credentials/etoro-v2-executor-postgres.service/v2-demo-execution.json --interval 2
Restart=on-failure
RestartSec=10
TimeoutStopSec=20
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
