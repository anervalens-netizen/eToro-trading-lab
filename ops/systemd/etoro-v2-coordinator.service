[Unit]
Description=eToro Trading Lab v2 autonomous closed-bar decision coordinator
After=network-online.target postgresql.service
Wants=network-online.target
ConditionPathExists=/etc/etoro-agent/v2-demo.json
ConditionPathExists=/etc/etoro-agent/etoro-demo-read-user-key
ConditionPathExists=/etc/etoro-agent/etoro-api-key
ConditionPathExists=/etc/etoro-agent/postgres-v2-engine-dsn

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=180
User=etoro-engine
Group=etoro-engine
WorkingDirectory=/opt/etoro-v2/current
Environment=PYTHONUNBUFFERED=1
Environment=ETORO_USER_KEY_FILE=/run/credentials/etoro-v2-coordinator.service/etoro-demo-read-user-key
Environment=ETORO_API_KEY_FILE=/run/credentials/etoro-v2-coordinator.service/etoro-api-key
Environment=ETORO_V2_POSTGRES_DSN_FILE=/run/credentials/etoro-v2-coordinator.service/postgres-v2-dsn
Environment=ETORO_V2_MASTER_LANE=D_sol_plus_critic
Environment=ETORO_V2_ROLE_RESEARCH=1
LoadCredential=etoro-demo-read-user-key:/etc/etoro-agent/etoro-demo-read-user-key
LoadCredential=etoro-api-key:/etc/etoro-agent/etoro-api-key
LoadCredential=postgres-v2-dsn:/etc/etoro-agent/postgres-v2-engine-dsn
LoadCredential=v2-demo.json:/etc/etoro-agent/v2-demo.json
ExecStart=/opt/etoro-v2/current/.venv/bin/python -m etoro_agent.coordinator_v2 --config /run/credentials/etoro-v2-coordinator.service/v2-demo.json --interval 60
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectProc=invisible
ProcSubset=pid
CapabilityBoundingSet=
AmbientCapabilities=
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
