[Unit]
Description=Verified backup of eToro trading audit database
After=etoro-shadow.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/opt/eToro/ops/backup/backup-sqlite.sh
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/storage/backups/db/etoro /opt/Mobiup/ops/backups/etoro
SystemCallArchitectures=native
