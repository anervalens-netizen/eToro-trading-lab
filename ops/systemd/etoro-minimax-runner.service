[Unit]
Description=Sandboxed MiniMax-M3 post-trade reviewer for eToro PAPER/DEMO
After=network-online.target etoro-sol-runner.service
Wants=network-online.target

[Service]
Type=simple
User=andrei
Group=andrei
WorkingDirectory=/opt/eToro-runtime
Environment=PYTHONUNBUFFERED=1
Environment=XDG_RUNTIME_DIR=/run/etoro-minimax-runner
ExecStart=/opt/eToro-runtime/.venv/bin/etoro-minimax-runner --interval 120
Restart=on-failure
RestartSec=20
RuntimeDirectory=etoro-minimax-runner
RuntimeDirectoryMode=0700
UMask=0077
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/run/etoro-minimax-runner
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelLogs=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
