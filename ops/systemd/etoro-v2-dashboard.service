[Unit]
Description=eToro Trading Lab v2 owner-only dashboard
After=network.target
ConditionPathExists=/etc/etoro-agent/v2-demo.json
ConditionPathExists=/etc/etoro-agent/proxy-secret

[Service]
Type=simple
User=etoro-agent
Group=etoro-agent
WorkingDirectory=/opt/eToro
Environment=PYTHONUNBUFFERED=1
Environment=ETORO_PROXY_SECRET_FILE=/run/credentials/etoro-v2-dashboard.service/proxy-secret
EnvironmentFile=-/etc/etoro-agent/dashboard.env
LoadCredential=proxy-secret:/etc/etoro-agent/proxy-secret
LoadCredential=v2-demo.json:/etc/etoro-agent/v2-demo.json
ExecStart=/opt/eToro/.venv/bin/python -m etoro_agent.dashboard_worker_v2 --runtime /var/lib/etoro-agent/v2.sqlite3 --config /run/credentials/etoro-v2-dashboard.service/v2-demo.json --uds /run/etoro-agent/v2-dashboard.sock
Restart=on-failure
RestartSec=5
RuntimeDirectory=etoro-agent
RuntimeDirectoryMode=0750
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
