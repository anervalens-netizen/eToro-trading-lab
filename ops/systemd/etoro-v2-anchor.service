[Unit]
Description=eToro Trading Lab v2 signed audit-chain anchor
After=postgresql.service
ConditionPathExists=/etc/etoro-agent/v2-anchor-signing.key
ConditionPathExists=/etc/etoro-agent/postgres-v2-dsn
ConditionPathIsDirectory=/storage/backups/db/etoro/v2-anchors

[Service]
Type=oneshot
User=etoro-agent
Group=etoro-agent
WorkingDirectory=/opt/eToro
LoadCredential=anchor-signing.key:/etc/etoro-agent/v2-anchor-signing.key
LoadCredential=postgres-v2-dsn:/etc/etoro-agent/postgres-v2-dsn
ExecStart=/opt/eToro/.venv/bin/python -m etoro_agent.anchor_worker_v2 --postgres-dsn-file /run/credentials/etoro-v2-anchor.service/postgres-v2-dsn --key /run/credentials/etoro-v2-anchor.service/anchor-signing.key --destination /storage/backups/db/etoro/v2-anchors
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/storage/backups/db/etoro/v2-anchors
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
