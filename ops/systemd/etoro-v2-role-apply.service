[Unit]
Description=eToro Trading Lab v2 bounded regime/critic memory applier
After=postgresql.service
ConditionPathExists=/etc/etoro-agent/v2-demo.json
ConditionPathExists=/etc/etoro-agent/postgres-v2-dsn

[Service]
Type=simple
User=etoro-agent
Group=etoro-agent
WorkingDirectory=/opt/eToro
Environment=PYTHONUNBUFFERED=1
Environment=ETORO_V2_POSTGRES_DSN_FILE=/run/credentials/etoro-v2-role-apply.service/postgres-v2-dsn
LoadCredential=postgres-v2-dsn:/etc/etoro-agent/postgres-v2-dsn
LoadCredential=v2-demo.json:/etc/etoro-agent/v2-demo.json
ExecStart=/opt/eToro/.venv/bin/python -m etoro_agent.role_apply_v2 --config /run/credentials/etoro-v2-role-apply.service/v2-demo.json --interval 5
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
