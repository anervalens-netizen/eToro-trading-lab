[Unit]
Description=eToro Trading Lab v2 independent deterministic DEMO exit manager
After=network-online.target postgresql.service etoro-v2-signer.service
Wants=network-online.target
Requires=etoro-v2-signer.service
Conflicts=etoro-demo-executor.service etoro-v2-execution-gate-lock.target
ConditionPathExists=/etc/etoro-agent/v2-demo-execution.json
ConditionPathExists=/etc/etoro-agent/etoro-demo-read-user-key
ConditionPathExists=/etc/etoro-agent/etoro-api-key
ConditionPathExists=/etc/etoro-agent/postgres-v2-exit-dsn
ConditionPathExists=/etc/etoro-agent/v2-risk-verifying.pub
ConditionPathExists=/etc/etoro-v2-control/ENABLE_DEMO_EXECUTION

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=120
User=etoro-exit
Group=etoro-exit
SupplementaryGroups=etoro-sign-requesters etoro-api-clients
UMask=0007
WorkingDirectory=/opt/etoro-v2/current
Environment=PYTHONUNBUFFERED=1
Environment=ETORO_V2_SHARED_RATE_LIMIT_DIR=/run/etoro-v2-api-rate-limit
Environment=ETORO_USER_KEY_FILE=/run/credentials/etoro-v2-exit-manager.service/etoro-demo-read-user-key
Environment=ETORO_API_KEY_FILE=/run/credentials/etoro-v2-exit-manager.service/etoro-api-key
Environment=ETORO_V2_POSTGRES_DSN_FILE=/run/credentials/etoro-v2-exit-manager.service/postgres-v2-dsn
Environment=ETORO_V2_RISK_SIGNER_SOCKET=/run/etoro-v2-signer/risk-signer.sock
Environment=ETORO_V2_RISK_VERIFYING_KEY_FILE=/run/credentials/etoro-v2-exit-manager.service/v2-risk-verifying.pub
LoadCredential=etoro-demo-read-user-key:/etc/etoro-agent/etoro-demo-read-user-key
LoadCredential=etoro-api-key:/etc/etoro-agent/etoro-api-key
LoadCredential=postgres-v2-dsn:/etc/etoro-agent/postgres-v2-exit-dsn
LoadCredential=v2-risk-verifying.pub:/etc/etoro-agent/v2-risk-verifying.pub
LoadCredential=v2-demo-execution.json:/etc/etoro-agent/v2-demo-execution.json
ExecStart=/opt/etoro-v2/current/.venv/bin/python -m etoro_agent.exit_manager_v2 --config /run/credentials/etoro-v2-exit-manager.service/v2-demo-execution.json --interval 2
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectProc=invisible
ProcSubset=pid
CapabilityBoundingSet=
AmbientCapabilities=
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
