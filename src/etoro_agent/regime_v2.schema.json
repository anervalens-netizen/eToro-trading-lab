{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object",
  "additionalProperties":false,
  "required":["regime_probabilities","event_risk","liquidity_risk","evidence_refs","summary"],
  "properties":{
    "regime_probabilities":{"type":"object","minProperties":1,"maxProperties":8,"additionalProperties":{"type":"number","minimum":0,"maximum":1}},
    "event_risk":{"enum":["LOW","MEDIUM","HIGH","UNKNOWN"]},
    "liquidity_risk":{"enum":["LOW","MEDIUM","HIGH","UNKNOWN"]},
    "evidence_refs":{"type":"array","maxItems":20,"items":{"type":"string","minLength":1,"maxLength":128}},
    "summary":{"type":"string","minLength":1,"maxLength":1000}
  }
}
