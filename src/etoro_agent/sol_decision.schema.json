{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["action", "candidate_id", "intent", "confidence", "reason_codes", "rationale"],
  "properties": {
    "action": {"type": "string", "enum": ["OPEN", "CLOSE", "HOLD"]},
    "candidate_id": {"type": "string", "maxLength": 100},
    "intent": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["symbol", "side", "amount_usd", "stop_loss_fraction", "take_profit_fraction", "max_holding_seconds"],
          "properties": {
            "symbol": {"type": "string", "minLength": 1, "maxLength": 16},
            "side": {"type": "string", "enum": ["buy", "sell"]},
            "amount_usd": {"type": "number", "exclusiveMinimum": 0},
            "stop_loss_fraction": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
            "take_profit_fraction": {"type": "number", "exclusiveMinimum": 0, "maximum": 2},
            "max_holding_seconds": {"type": "integer", "minimum": 300, "maximum": 604800}
          }
        }
      ]
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9_]+$"}
    },
    "rationale": {"type": "string", "minLength": 1, "maxLength": 1000}
  }
}
